# Боевая конфигурация: /etc/nado/nado.env (root:nado, 0640).
# Формат systemd EnvironmentFile: комментарии — только отдельной строкой,
# «KEY=value # коммент» попадёт в значение целиком. Значения со спецсимволами
# и пробелами — в одинарных кавычках: DB_PASSWORD='p@ss w0rd'.

APP_NAME=nado
APP_ENV=prod
# false обязательно: в debug шаблоны читаются с диска, а на сервере их нет.
APP_DEBUG=false
# Адрес сайта для canonical и hreflang (без слеша в конце).
APP_PUBLIC_URL=https://nado.kz
LOG_LEVEL=info

# Только localhost — наружу приложение отдаёт nginx из Plesk.
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=25s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_ALLOWED_ORIGINS=https://example.com

DB_HOST=localhost
DB_PORT=1433
DB_USER=nado
DB_PASSWORD=change_me
DB_NAME=nado
DB_INSTANCE=
DB_ENCRYPT=true
# В prod true запрещён конфигом: у SQL Server должен быть доверенный сертификат.
DB_TRUST_SERVER_CERTIFICATE=false
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=5s

# Секреты и мессенджер
# SECRETS_KEY обязателен в prod: base64 от 32 случайных байт.
#   сгенерировать: openssl rand -base64 32
SECRETS_KEY=
OTP_TTL=5m
GREEN_API_PARTNER_DOMAIN=
GREEN_API_PARTNER_TOKEN=
GREEN_API_WEBHOOK_TOKEN=

# Почтовый ящик служебных сотрудников Kaspi (IMAP). TLS проверяется всегда.
MAILBOX_IMAP_ADDR=
MAILBOX_IMAP_USER=
MAILBOX_IMAP_PASSWORD=
MAILBOX_IMAP_FOLDER=INBOX
MAILBOX_IMAP_SERVER_NAME=
MAILBOX_IMAP_POLL=15s
MAILBOX_CODE_TTL=10m

# Кабинетный онбординг Kaspi.
KASPI_EMPLOYEE_EMAIL_DOMAIN=kaspi.nado.kz

# Маршрутизация витрин по Host (прод).
PLATFORM_ROOT_HOST=nado.kz
PLATFORM_APP_HOST=app.nado.kz
PLATFORM_SHOP_SUFFIX=nado.kz
