# Приложение
APP_NAME=nado
APP_ENV=local            # local | dev | prod
APP_DEBUG=true           # true — шаблоны читаются с диска на каждый запрос
APP_PUBLIC_URL=          # адрес сайта для canonical/hreflang, напр. https://nado.kz; пусто — относительные ссылки
LOG_LEVEL=info           # debug | info | warn | error

# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=25s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_ALLOWED_ORIGINS=*

# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=change_me
DB_NAME=nado
DB_INSTANCE=                       # напр. SQLEXPRESS, если используется именованный инстанс
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true   # только для локального сервера с самоподписанным сертификатом
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=5s

# Секреты и мессенджер
SECRETS_KEY=                # base64 32 байта (AES-256) для шифрования токенов; в prod обязателен, локально можно пусто
OTP_TTL=5m                  # срок действия кода подтверждения телефона
GREEN_API_PARTNER_DOMAIN=   # домен партнёрского API GreenAPI (для создания инстансов)
GREEN_API_PARTNER_TOKEN=    # партнёрский токен GreenAPI
GREEN_API_WEBHOOK_TOKEN=    # секрет в URL вебхука /webhooks/greenapi/<token>

# Почтовый ящик служебных сотрудников Kaspi (IMAP): коды входа в кабинет и пароли.
# Оставьте пустым локально — тогда поллер не запускается. TLS проверяется всегда.
MAILBOX_IMAP_ADDR=          # host:port IMAPS, напр. mail.nado.kz:993
MAILBOX_IMAP_USER=          # логин ящика (catch-all служебных адресов)
MAILBOX_IMAP_PASSWORD=      # пароль ящика
MAILBOX_IMAP_FOLDER=INBOX   # папка для опроса
MAILBOX_IMAP_SERVER_NAME=   # имя для проверки TLS-сертификата, если отличается от хоста
MAILBOX_IMAP_POLL=15s       # период опроса ящика
MAILBOX_CODE_TTL=10m        # срок годности кода из письма и время его хранения

# Кабинетный онбординг Kaspi: домен адресов служебных сотрудников (catch-all ящик выше).
KASPI_EMPLOYEE_EMAIL_DOMAIN=kaspi.nado.kz

# Маршрутизация по Host. В проде задайте домены — витрины выбираются по Host
# (<slug>.<PLATFORM_SHOP_SUFFIX>). Локально оставьте пусто: витрина под /shop/{slug}.
PLATFORM_ROOT_HOST=          # лендинг платформы, напр. nado.kz
PLATFORM_APP_HOST=           # кабинет продавца, напр. app.nado.kz
PLATFORM_SHOP_SUFFIX=        # поддомены витрин, напр. nado.kz
