{{ define "content" }}
<div class="panel">
  <div class="row-between">
    <h1>{{ .L.T "shop.account_title" }}</h1>
    <form method="post" action="{{ .LangBase }}/logout"><button class="btn btn--outline btn--sm" type="submit">{{ .L.T "shop.logout" }}</button></form>
  </div>
  <p class="muted">{{ .Customer.PhoneE164 }}{{ with .Customer.Name }} · {{ . }}{{ end }}</p>

  <h2 class="section-title">{{ .L.T "shop.my_orders" }}</h2>
  {{ if .Orders }}
  <div class="table-scroll">
    <table class="orders-table">
      <thead>
        <tr>
          <th>{{ .L.T "shop.order_number" }}</th>
          <th>{{ .L.T "shop.order_date" }}</th>
          <th>{{ .L.T "shop.order_status" }}</th>
          <th class="ta-right">{{ .L.T "shop.order_total" }}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{ range .Orders }}
        {{ $paid := eq .Status "paid" }}
        {{ $canceled := eq .Status "canceled" }}
        <tr>
          <td><a href="{{ $.LangBase }}/order/{{ .Number }}?t={{ .Token }}">№ {{ .Number }}</a></td>
          <td class="muted">{{ if .CreatedAt.IsZero }}—{{ else }}{{ formatDate "02.01.2006" .CreatedAt }}{{ end }}</td>
          <td>
            <span class="status-pill {{ if $paid }}status-pill--paid{{ else if $canceled }}status-pill--canceled{{ else }}status-pill--pending{{ end }}">
              {{ $.L.T (printf "shop.status_%s" .Status) }}
            </span>
          </td>
          <td class="ta-right">{{ money .TotalMinor .Currency $.Lang }}</td>
          <td class="ta-right">
            {{ if and (not $paid) (not $canceled) }}
            <a class="btn btn--primary btn--sm" href="{{ $.LangBase }}/pay/{{ .Number }}?t={{ .Token }}">{{ $.L.T "shop.pay_now" }}</a>
            {{ end }}
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
  {{ else }}
  <p class="muted">{{ .L.T "shop.no_orders" }}</p>
  {{ end }}

  <hr class="hr-soft mt-24">
  <form method="post" action="{{ .LangBase }}/account/delete" class="mt-12">
    <button class="btn btn--outline btn--sm" type="submit">{{ .L.T "shop.delete_account" }}</button>
  </form>
</div>
{{ end }}
