{{ define "content" }}
{{ $p := .Product }}
<nav class="breadcrumbs"><a href="{{ .LangBase }}/">{{ .L.T "shop.home_title" }}</a> / {{ $p.Title }}</nav>
<article class="product">
  {{ if gt (len $p.Images) 1 }}
  {{/* Галерея без JS (CSP script-src 'self'): радиокнопки-переключатели + подписи.
       Клик по миниатюре выбирает её радиокнопку, а CSS показывает нужное фото. */}}
  <div class="gallery">
    {{ range $i, $u := $p.Images }}<input class="gallery__radio" type="radio" name="pgal" id="pgal-{{ $i }}" aria-label="{{ $p.Title }}"{{ if eq $i 0 }} checked{{ end }}>{{ end }}
    <div class="gallery__main">
      {{ range $i, $u := $p.Images }}<img class="gallery__slide" src="{{ img $u }}" alt="{{ $p.Title }}"{{ if ne $i 0 }} loading="lazy"{{ end }}>{{ end }}
    </div>
    <div class="gallery__thumbs">
      {{ range $i, $u := $p.Images }}<label class="gallery__thumb" for="pgal-{{ $i }}"><img src="{{ img $u }}" alt="" loading="lazy"></label>{{ end }}
    </div>
  </div>
  {{ else }}
  <div class="gallery">
    <div class="gallery__main">
      {{ if $p.Images }}<img src="{{ img (index $p.Images 0) }}" alt="{{ $p.Title }}">{{ end }}
    </div>
  </div>
  {{ end }}

  <div class="product__info">
    <h1>{{ $p.Title }}</h1>
    {{ with $p.Brand }}<p class="muted">{{ $.L.T "shop.brand" }}: {{ . }}</p>{{ end }}
    <p class="product__price">{{ money $p.PriceMinor $p.Currency .Lang }}{{ if $p.OldPriceMinor }} <span class="card__old">{{ money $p.OldPriceMinor $p.Currency .Lang }}</span>{{ end }}</p>

    {{ if $p.Available }}
    <form method="post" action="{{ .LangBase }}/cart/add" class="mt-12">
      <input type="hidden" name="variant_id" value="{{ $p.VariantID }}">
      <input type="hidden" name="qty" value="1">
      <button class="btn btn--primary btn--lg" type="submit">{{ .L.T "shop.add_to_cart" }}</button>
    </form>
    {{ else }}
    <p class="card__out mt-12">{{ .L.T "shop.out_of_stock" }}</p>
    {{ end }}

    {{ with $p.Description }}
    <div class="product__desc">
      <h2>{{ $.L.T "shop.description" }}</h2>
      <p>{{ . }}</p>
    </div>
    {{ end }}
  </div>
</article>
{{ end }}
