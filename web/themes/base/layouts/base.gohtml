{{/* Каркас витрины магазина. Тема (D-21): data-theme ставится при явном выборе;
     «как в системе» работает через media-запрос. */}}
<!doctype html>
<html lang="{{ .Lang }}"{{ if or (eq .ThemeMode "light") (eq .ThemeMode "dark") }} data-theme="{{ .ThemeMode }}"{{ end }}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ block "title" . }}{{ .Title }} — {{ .Store.Name }}{{ end }}</title>
  {{ with .Description }}<meta name="description" content="{{ . }}">{{ end }}
  <meta name="color-scheme" content="light dark">
  {{ with .Canonical }}<link rel="canonical" href="{{ . }}">{{ end }}
  <link rel="stylesheet" href="{{ .Prefix }}/static/css/theme.css">
  <script src="{{ .Prefix }}/static/js/theme.js" defer></script>
  {{ block "head_extra" . }}{{ end }}
</head>
<body>
  <a class="skip-link" href="#main">{{ .L.T "shop.skip" }}</a>
  {{ template "header" . }}
  <main id="main" class="container">
    {{ block "content" . }}{{ end }}
  </main>
  {{ template "footer" . }}
</body>
</html>
