{{/* Постраничная навигация.
     Ожидает dict: Page, TotalPages, Total, Path, Search.
     Число страниц считается в обработчике — в шаблоне нет арифметики int64. */}}
{{ define "pagination" }}
<nav class="pagination">
    {{ if gt .Page 1 }}
        <a class="pagination__link" href="{{ .Path }}?page={{ sub .Page 1 }}&amp;search={{ .Search }}">← Назад</a>
    {{ end }}
    <span class="pagination__status">Страница {{ .Page }} из {{ .TotalPages }} · всего {{ .Total }}</span>
    {{ if lt .Page .TotalPages }}
        <a class="pagination__link" href="{{ .Path }}?page={{ add .Page 1 }}&amp;search={{ .Search }}">Вперёд →</a>
    {{ end }}
</nav>
{{ end }}
