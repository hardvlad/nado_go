{{ define "content" }}
<section class="section page-section">
    <div class="container container--form">
        <header class="page-head page-head--center">
            <span class="logo__mark logo__mark--lg">{{ template "icon" "message" }}</span>
            <h1 class="page-head__title">{{ .L.T "register.code_heading" }}</h1>
            <p class="page-head__lead">{{ .L.T "register.code_sent" "Phone" (index .Form.Values "phone") }}</p>
        </header>

        <form class="form-card" method="post" action="{{ .Links.RegisterVerify }}" novalidate>
            {{ with .Form.Alert }}{{ template "alert" dict "Kind" "danger" "Text" . }}{{ end }}
            <input type="hidden" name="phone" value="{{ index .Form.Values "phone" }}">
            <input type="hidden" name="name" value="{{ index .Form.Values "name" }}">
            <input type="hidden" name="email" value="{{ index .Form.Values "email" }}">

            {{ template "field" dict "Form" .Form "Name" "code" "Label" (.L.T "phone.code_label") "Type" "text"
                "Autocomplete" "one-time-code" "Inputmode" "numeric" "Required" true "Max" 6 "Hint" (.L.T "phone.code_hint") }}

            <button class="btn btn--primary btn--lg btn--block" type="submit">{{ .L.T "register.submit" }}</button>
            <p class="form-card__footer"><a href="{{ .Links.Register }}">{{ .L.T "phone.change_phone" }}</a></p>
        </form>
    </div>
</section>
{{ end }}
