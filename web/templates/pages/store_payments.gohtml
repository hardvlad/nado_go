{{/* Кабинет: настройки приёма оплат магазином (мерчант продавца). */}}
{{ define "content" }}
<section class="section page-section">
    <div class="container container--form">
        <header class="page-head page-head--center">
            <span class="logo__mark logo__mark--lg">{{ template "icon" "wallet" }}</span>
            <h1 class="page-head__title">{{ .L.T "pay.title" }}{{ with .StoreName }} · {{ . }}{{ end }}</h1>
            <p class="page-head__lead">{{ .L.T "pay.lead" }}</p>
        </header>

        {{ if .Saved }}{{ template "alert" dict "Kind" "success" "Text" (.L.T "pay.saved") }}{{ end }}
        {{ with .Form.Alert }}{{ template "alert" dict "Kind" "danger" "Text" . }}{{ end }}

        <form class="form-card" method="post" action="{{ .Action }}" novalidate>
            <div class="field">
                <label class="field__label" for="provider">{{ .L.T "pay.provider" }}</label>
                <select class="input" id="provider" name="provider">
                    {{ range .Providers }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }}>{{ .Label }}</option>{{ end }}
                </select>
            </div>
            <div class="field field--check">
                <label class="check"><input type="checkbox" name="enabled" value="1"{{ if .Settings.IsEnabled }} checked{{ end }}> <span>{{ .L.T "pay.enabled" }}</span></label>
            </div>
            <div class="field">
                <label class="field__label" for="merchant_id">{{ .L.T "pay.merchant_id" }}</label>
                <input class="input" id="merchant_id" name="merchant_id" type="text" maxlength="200" value="{{ .Settings.MerchantID }}">
            </div>
            <div class="field">
                <label class="field__label" for="secret">{{ .L.T "pay.secret" }} <span class="field__optional">({{ .L.T "form.optional" }})</span></label>
                <input class="input" id="secret" name="secret" type="password" autocomplete="new-password" maxlength="400"
                    placeholder="{{ if .Settings.HasSecret }}{{ .L.T `pay.secret_set` }}{{ else }}{{ .L.T `pay.secret_ph` }}{{ end }}">
                <p class="field__hint">{{ .L.T "pay.secret_hint" }}</p>
            </div>
            <div class="field field--check">
                <label class="check"><input type="checkbox" name="testing" value="1"{{ if .Settings.Testing }} checked{{ end }}> <span>{{ .L.T "pay.testing" }}</span></label>
            </div>

            <button class="btn btn--primary btn--lg btn--block" type="submit">{{ .L.T "pay.save" }}</button>
            <p class="form-card__footer"><a href="{{ .AccountURL }}">{{ .L.T "pay.to_account" }}</a></p>
        </form>

        {{ with .WebhookURL }}
        <div class="form-card">
            <h2 class="form-card__title">{{ $.L.T "pay.webhook_title" }}</h2>
            <p class="field__hint">{{ $.L.T "pay.webhook_hint" }}</p>
            <code class="code-block">{{ . }}</code>
        </div>
        {{ end }}
    </div>
</section>
{{ end }}
