{{/* Кабинет: методы приёма оплат магазина (несколько провайдеров одновременно). */}}
{{ define "content" }}
<section class="section page-section">
    <div class="container container--narrow">
        <div class="section-head section-head--row">
            <h1 class="page-head__title">{{ .L.T "pay.title" }}{{ with .StoreName }} · {{ . }}{{ end }}</h1>
            <a class="btn btn--ghost btn--sm" href="{{ .AccountURL }}">{{ .L.T "pay.to_account" }}</a>
        </div>

        {{ if .Saved }}{{ template "alert" dict "Kind" "success" "Text" (.L.T "pay.saved") }}{{ end }}
        {{ if .Deleted }}{{ template "alert" dict "Kind" "success" "Text" (.L.T "pay.deleted") }}{{ end }}

        <p class="muted">{{ .L.T "pay.lead" }}</p>
        {{ if gt .EnabledCount 1 }}{{ template "alert" dict "Kind" "info" "Text" (.L.T "pay.multi_note") }}{{ end }}

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>{{ .L.T "pay.col_method" }}</th>
                        <th>{{ .L.T "pay.col_status" }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{ range .Methods }}
                    <tr>
                        <td>{{ .Label }}</td>
                        <td>
                            {{ if .IsEnabled }}<span class="badge badge--active">{{ $.L.T "pay.st_enabled" }}</span>
                            {{ else if .Configured }}<span class="badge badge--muted">{{ $.L.T "pay.st_off" }}</span>
                            {{ else }}<span class="badge badge--muted">{{ $.L.T "pay.st_none" }}</span>{{ end }}
                        </td>
                        <td><a class="btn btn--ghost btn--sm" href="{{ .EditURL }}">{{ if .Configured }}{{ $.L.T "pay.edit" }}{{ else }}{{ $.L.T "pay.connect" }}{{ end }}</a></td>
                    </tr>
                    {{ end }}
                </tbody>
            </table>
        </div>
    </div>
</section>
{{ end }}
