{{ define "title" }}{{ .User.Name }} — {{ .AppName }}{{ end }}

{{ define "content" }}
<article class="card">
    <h1>{{ .User.Name }}</h1>
    <dl class="card__props">
        <dt>ID</dt><dd>{{ .User.ID }}</dd>
        <dt>Email</dt><dd>{{ .User.Email }}</dd>
        <dt>Статус</dt><dd>{{ .User.Status }}</dd>
        <dt>Создан</dt><dd>{{ formatDate "02.01.2006 15:04" .User.CreatedAt }}</dd>
        <dt>Обновлён</dt><dd>{{ formatDate "02.01.2006 15:04" .User.UpdatedAt }}</dd>
    </dl>
    <a class="button" href="/users">К списку</a>
</article>
{{ end }}
